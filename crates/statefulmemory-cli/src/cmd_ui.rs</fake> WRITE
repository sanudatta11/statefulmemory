  function drawGraph(d ){
    const svg=$('#svg'); svg.innerHTML='';
    const W=svg.clientWidth||900,H=340;
    const nodes={}; d.entities?.forEach(en=>{nodes[en.id]=Object.assign({},en);});
    const edges=d.edges||[];
    // Simple radial layout around seed.
    const center=nodes[d.seed]?Object.keys(nodes).find(id=>nodes[id].name===d.seed):null;
    const ring=Object.keys(nodes).filter(id=>id!==center);
    const N=ring.length||1;
    const r=Math.min(W,H)/2-40;
    const cx=W/2,cy=H/2;
    const pos={};
    if(center!=null){pos[center]={x:cx,y:cy};}
    ring.forEach((id,i)=>{const a=2*Math.PI*i/N - Math.PI/2;pos[id]={x:cx+r*Math.cos(a),y:cy+r*Math.sin(a)};});
    edges.forEach(ed=>{const s=pos[ed.source],t=pos[ed.target];if(!s||!t)return;
