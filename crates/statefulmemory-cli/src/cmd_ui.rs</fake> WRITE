      t.setAttribute('x',p.x+id===center?16:10);t.setAttribute('y',p.y+4);t.setAttribute('fill','#c9d2de');t.setAttribute('font-size','12');
      t.textContent=n.name.slice(0,22);
      g.appendChild(c);g.appendChild(t);svg.appendChild(g);});
  }

  $('#dbtn').add  addEventListener('click',async ()=>{
    const q=$('#dq').value.trim(); if(!q)return;
