#!/usr/bin/env bash
# Enforce .cursor/rules/git-commits.mdc on every commit.
# Install: git config core.hooksPath .githooks
set -euo pipefail

msg_file="${1:?commit-msg hook requires a message file}"

# Drop comment lines Git leaves in the editor template; keep real content.
mapfile -t lines < <(grep -v '^#' "$msg_file" | sed -e 's/[[:space:]]*$//' )

# Trim leading/trailing blank lines only.
while [[ ${#lines[@]} -gt 0 && -z "${lines[0]}" ]]; do
  lines=("${lines[@]:1}")
done
while [[ ${#lines[@]} -gt 0 && -z "${lines[-1]}" ]]; do
  unset 'lines[-1]'
done

if [[ ${#lines[@]} -eq 0 ]]; then
  echo "commit-msg: empty commit message" >&2
  exit 1
fi

if [[ ${#lines[@]} -ne 1 ]]; then
  echo "commit-msg: message must be exactly one line (no body/footers)" >&2
  echo "commit-msg: got ${#lines[@]} content lines:" >&2
  printf '  | %s\n' "${lines[@]}" >&2
  exit 1
fi

subject="${lines[0]}"

# Conventional Commits: type(scope)?: subject  OR  type: subject
if ! [[ "$subject" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?:\ .+ ]]; then
  echo "commit-msg: subject must be Conventional Commits:" >&2
  echo "  <type>(<scope>): <subject>   or   <type>: <subject>" >&2
  echo "commit-msg: got: $subject" >&2
  exit 1
fi

# Full file (including comments-stripped content) for trailer scans.
body="$(printf '%s\n' "${lines[@]}")"
if echo "$body" | grep -Eiq \
  '^(co-authored-by|assisted-by|signed-off-by)\s*:|[[:space:]](generated by|written with|assisted by)\>'; then
  echo "commit-msg: attribution trailers/phrases are forbidden" >&2
  echo "commit-msg: remove Co-authored-by / Assisted-by / Signed-off-by / AI credit lines" >&2
  exit 1
fi

# Also scan the raw file in case a trailer was added as a Git comment somehow.
if grep -Eiq '^(co-authored-by|assisted-by|signed-off-by)\s*:' "$msg_file"; then
  echo "commit-msg: attribution trailer found in commit message file" >&2
  exit 1
fi

exit 0
