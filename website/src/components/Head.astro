---
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const id = route?.id ?? '';
const is404 = id === '404' || pathname === '/404' || pathname === '/404/';
const isDocs = pathname.startsWith('/docs/') && !is404;

const site = Astro.site?.origin ?? 'https://statefulmemory.dev';
const canonical = new URL(pathname, Astro.site ?? Astro.url).href;
const title = route?.entry?.data?.title ?? 'statefulmemory';
const description = route?.entry?.data?.description;

const ld = isDocs
	? JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'BreadcrumbList',
					itemListElement: [
						{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
						{ '@type': 'ListItem', position: 2, name: title, item: canonical },
					],
				},
				{
					'@type': 'TechArticle',
					headline: title,
					description,
					url: canonical,
					inLanguage: 'en',
					mainEntityOfPage: canonical,
					isPartOf: { '@type': 'WebSite', name: 'statefulmemory', url: site },
					publisher: { '@type': 'Organization', name: 'statefulmemory', url: site },
				},
			],
		}).replace(/</g, '\\u003c')
	: null;
---

<Default />

{is404 ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}

{ld && <script type="application/ld+json" set:html={ld} />}
